rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
function signedIn(){return request.auth!=null;} function admin(){return signedIn()&&request.auth.token.admin==true;}
match /users/{id}{allow read,update:if signedIn()&&(request.auth.uid==id||admin());allow create:if signedIn()&&request.auth.uid==id;}
match /businesses/{id}{allow read:if resource.data.status=='active'||admin();allow create,update,delete:if admin();match /benefits/{bid}{allow read:if resource.data.status=='active'||admin();allow write:if admin();}}
match /customers/{id}{allow read,update:if signedIn()&&(request.auth.uid==id||admin());allow create:if signedIn()&&request.auth.uid==id;}
match /networkEvents/{id}{allow read:if admin();allow create:if signedIn();allow update,delete:if admin();}
match /{document=**}{allow read,write:if false;}}}
